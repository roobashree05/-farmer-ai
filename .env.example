# Copy to .env and replace secrets before running locally.
# These values are local-development placeholders, not production credentials.

DATABASE_URL=postgresql://aijewel:aijewel@localhost:5432/aijewel
REDIS_URL=redis://localhost:6379

# Generate long random strings. Do not reuse these placeholders outside a laptop.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_EMAIL=admin@aijewel.local
NEXT_PUBLIC_DEMO_PASSWORD=Local-demo-1234

UPLOAD_DIRECTORY=./storage/recordings
TZ=Asia/Kolkata

AI_PROVIDER=mock
WHATSAPP_PROVIDER=mock
META_PROVIDER=mock
VOICE_PROVIDER=mock
CALENDAR_PROVIDER=mock
STORAGE_PROVIDER=local

DEMO_MODE=true
SCHEDULER_ENABLED=true
SEED_PASSWORD=Local-demo-1234

WHATSAPP_GROUP_FIXTURE=./mocks/whatsapp/aijewel-hyderabad-group.json
