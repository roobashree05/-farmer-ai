# Copy to .env and replace secrets before running locally.
# These values are local-development placeholders, not production credentials.

DATABASE_URL=postgresql://aijewel:aijewel@localhost:5432/aijewel

# Compose reads these for the Postgres container. Keep them in agreement with DATABASE_URL.
# The API process reads DATABASE_URL only.
POSTGRES_USER=aijewel
POSTGRES_PASSWORD=aijewel
POSTGRES_DB=aijewel

# Compose injects REDIS_URL. The API does not read it yet. Login rate limiting stays in process memory.
REDIS_URL=redis://localhost:6379

# Generate long random strings. Do not reuse these placeholders outside a laptop.
JWT_SECRET=replace-with-a-long-random-string
# Reserved. Refresh tokens are random values stored as SHA-256 hashes. The API does not sign them with this secret.
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_EMAIL=admin@aijewel.local
# Must match SEED_PASSWORD. The login form reads this public value.
NEXT_PUBLIC_DEMO_PASSWORD=Local-demo-1234

UPLOAD_DIRECTORY=./storage/recordings
TZ=Asia/Kolkata

# mock keeps answers inside the knowledge-base scorer.
# anthropic calls Claude. The API refuses to start when anthropic is selected
# and ANTHROPIC_API_KEY is missing or invalid. ANTHROPIC_MODEL is optional.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

WHATSAPP_PROVIDER=mock
# META_PROVIDER is the ads-metrics adapter. Only mock is implemented.
META_PROVIDER=mock
VOICE_PROVIDER=mock
CALENDAR_PROVIDER=mock
STORAGE_PROVIDER=local

# Shown in Settings and health. It does not select providers. The *_PROVIDER variables do.
DEMO_MODE=true
SCHEDULER_ENABLED=true
SEED_PASSWORD=Local-demo-1234

WHATSAPP_GROUP_FIXTURE=./mocks/whatsapp/aijewel-hyderabad-group.json

# Leave these blank while WHATSAPP_PROVIDER=mock. Set WHATSAPP_PROVIDER=meta only
# with real Meta credentials. Supported Graph API versions: v21.0, v22.0, v23.0,
# v24.0, v25.0, v26.0. v25.0 matches the Cloud API send-messages guide.
# PUBLIC_BASE_URL is the HTTPS origin Meta can reach, without a trailing path.
# The webhook callback is PUBLIC_BASE_URL/api/webhooks/whatsapp.
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
PUBLIC_BASE_URL=
